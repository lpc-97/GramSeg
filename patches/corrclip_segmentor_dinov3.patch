+    @staticmethod
+    def _load_dinov3_timm(dino_type):
+        """DINOv3 backbone via timm, weights from a LOCAL safetensors file
+        (no network). Path comes from $DINOV3_WEIGHTS, default
+        ~/dino_rtp_seg/dinov3_vits16.safetensors. Trigger at eval time with
+        --cfg-options model.dino_type=dinov3_vits16
+        """
+        try:
+            import timm
+        except ImportError as e:
+            raise ImportError(
+                f"dino_type={dino_type} needs timm with DINOv3 support "
+                f"(>= 1.0.20) in this env. Fix: pip install -U timm") from e
+        timm_names = {
+            'dinov3_vits16': 'vit_small_patch16_dinov3.lvd1689m',
+            'dinov3_vitb16': 'vit_base_patch16_dinov3.lvd1689m',
+        }
+        assert dino_type in timm_names, \
+            f"unknown dinov3 dino_type: {dino_type} (known: {sorted(timm_names)})"
+        weights = os.environ.get('DINOV3_WEIGHTS', os.path.expanduser(
+            '~/dino_rtp_seg/dinov3_vits16.safetensors'))
+        assert os.path.isfile(weights), (
+            f"DINOv3 weights not found: {weights} -- set $DINOV3_WEIGHTS to "
+            f"the local timm-converted safetensors file")
+        try:
+            return timm.create_model(
+                timm_names[dino_type], pretrained=True, num_classes=0,
+                dynamic_img_size=True, pretrained_cfg_overlay=dict(file=weights))
+        except Exception as e:
+            raise RuntimeError(
+                f"timm.create_model('{timm_names[dino_type]}') failed -- this "
+                f"timm probably predates DINOv3. Fix: pip install -U timm "
+                f"(cause: {e})") from e
